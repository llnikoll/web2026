rules_version='2'

service cloud.firestore {
  match /databases/{database}/documents {
    // Permitir leer y escribir contadores
    match /counters/{document} {
      allow read, write: if true;
    }
    
    // Denegar todo lo demás por seguridad
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
